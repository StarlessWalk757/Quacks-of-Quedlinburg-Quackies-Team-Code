public class BonusDie{
    private int[] faces;
    private int f;
    
    public BonusDie(){
        faces = {1,2,3,4,5,6};
    }
    public static int roll(){
        f = (int)Math.random()*6+1;
        return f;
    }
    public apply(Player p, int face){
        if(face.equals(1||2||6)){
            p.addVictoryPoints(1);
        }
        else if(face.equals(3)){
            p.addVictoryPoints(2);
        }
        else if(face.equals(4)){
            p.addToken(OrangePumpkin);
        }
        else if(face.equals(5)){
            p.moveDroplet();
        }
        else if(face.equals(6)){
            p.addRubies(1);
        }
    }
}